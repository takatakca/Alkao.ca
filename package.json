{
  "name": "alkao",
  "version": "0.1.0",
  "private": true,
  "description": "ALKAO — TAKATAK Ticket Hub: standalone multi-tenant ticketing engine.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:migrations": "tsx scripts/check-migrations-rls.ts",
    "db:local:start": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop",
    "test": "vitest run",
    "test:domain": "vitest run test/domain",
    "test:db": "vitest run test/db",
    "qa": "npm run typecheck && npm run check:migrations && npm test",
    "start": "tsx src/server.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "worker:sweeper": "tsx scripts/sweeper.ts",
    "worker:email": "tsx scripts/email-worker.ts",
    "worker:cancellations": "tsx scripts/cancellation-worker.ts",
    "control:apply": "tsx scripts/control-apply.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "htm": "^3.1.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
