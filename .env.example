# ALKAO — TAKATAK Ticket Hub. Copy to .env for local runs; never commit real values.

DATABASE_URL=postgres://postgres@127.0.0.1:54329/alkao_dev

# Deployment switch. Default false: every operational route refuses until explicitly enabled
# AND TAKATAK grants the Ticketing entitlement for the Client/Brand.
ALKAO_OPERATIONAL_API_ENABLED=false

# TAKATAK control contract (alkao.control.v1): comma-separated kid:secret pairs (secret >= 32 chars).
ALKAO_CONTROL_KEYS=

# Supabase Auth access tokens: JWKS URL (asymmetric keys) or the legacy HS256 secret.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=

# Stripe Connect (Run 02). Both keys are required, or payments stay off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALKAO_STRIPE_ONBOARDING_REFRESH_URL=
ALKAO_STRIPE_ONBOARDING_RETURN_URL=

# QR credentials (Run 03): Client Ed25519 keys are derived from this secret (>= 32 chars). Never stored.
ALKAO_CREDENTIAL_MASTER_SECRET=

# Operations app (/ops): Supabase sign-in (public values) and who may embed it in an iframe.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# TAKATAK dashboard origin(s) allowed to embed /ops, e.g. https://app.takatak.ca
ALKAO_OPS_FRAME_ANCESTORS=

ALKAO_HOLD_TTL_SECONDS=600
ALKAO_PUBLIC_HOLDS_PER_MINUTE=20
PORT=8787

# Tests: local, ephemeral PostgreSQL only (scripts/local-postgres.sh). Non-loopback hosts are refused.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres

# Run 06: buyers' tickets email (npm run worker:email). Nothing is sent without these.
ALKAO_PUBLIC_URL=
RESEND_API_KEY=
ALKAO_EMAIL_FROM=
ALKAO_EMAIL_MAX_AGE_HOURS=72

# Run 13: reverse proxies in front of ALKAO (0 = exposed directly, 1 = load balancer, 2 = CDN + LB)
ALKAO_TRUSTED_PROXY_HOPS=1
