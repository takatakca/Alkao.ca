# ALKAO — TAKATAK Ticket Hub. Copy to .env for local runs; never commit real values.

DATABASE_URL="postgresql://postgres.pcjfahhlozsseqqevimi:JHVG897yBBoih8809HH@$fegf@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30&connect_timeout=30&sslmode=require"
