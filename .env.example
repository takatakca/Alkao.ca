# Run 06: buyers' tickets email (npm run worker:email). Nothing is sent without these.
ALKAO_PUBLIC_URL=https://alkao.ca
# Optional white-label root redirect. Must be an absolute HTTPS URL. Leave empty on alkao.ca.
ALKAO_HOME_URL=
RESEND_API_KEY=re_ebVW7hvL_5QGi7x73NeXDm2JtZaMSYFT2
ALKAO_EMAIL_FROM=billets@takatak.ca
ALKAO_EMAIL_MAX_AGE_HOURS=72
# Run 48: Resend's webhook (bounces, spam complaints): POST ${ALKAO_PUBLIC_URL}/v1/webhooks/resend
# with email.bounced, email.complained, email.suppressed; its signing secret (whsec_…) here.
RESEND_WEBHOOK_SECRET=whsec_RQUQJZILSkRNEbxUd1ip1Eaa/YHb1Zzj
# Run 48: campaign e-mails per hour, all Brands together (a new sending domain earns trust slowly).
ALKAO_CAMPAIGN_EMAILS_PER_HOUR=300

# Run 13: reverse proxies in front of ALKAO (0 = exposed directly, 1 = load balancer, 2 = CDN + LB)
ALKAO_TRUSTED_PROXY_HOPS=1

# Run 14: one log line per request (route pattern, status, duration; never ids or PII)
ALKAO_LOG_REQUESTS=true

# Run 46: text-message campaigns through Twilio (optional). A Messaging Service (MG…) is
